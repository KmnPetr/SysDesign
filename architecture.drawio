        <mxCell id="sqVjTN24lTVAuIK02rsc-58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="&lt;h3&gt;Nginx + Lua 🌐&lt;br&gt;• cashe&lt;/h3&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="290" y="2355" as="geometry" />
