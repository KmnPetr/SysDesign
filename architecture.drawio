        <mxCell id="sqVjTN24lTVAuIK02rsc-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;h2 style=&quot;margin-bottom: 1px;&quot;&gt;Edge Node (Россия)&lt;/h2&gt;&lt;h3 style=&quot;margin-top: 1px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ip =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;20.0.10.53&lt;/span&gt;&lt;/h3&gt;" vertex="1">
