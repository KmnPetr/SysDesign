        <mxCell id="uFjHU1NVOYnnqD2MqNxn-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Statistc counter&lt;/b&gt;&lt;/font&gt;" vertex="1">
