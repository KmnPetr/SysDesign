        </mxCell>
        <mxCell id="sqVjTN24lTVAuIK02rsc-18" edge="1" parent="1" source="sqVjTN24lTVAuIK02rsc-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.145;entryY=1;entryDx=0;entryDy=-4.35;entryPerimeter=0;curved=1;strokeWidth=2;" target="sqVjTN24lTVAuIK02rsc-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sqVjTN24lTVAuIK02rsc-19" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h2 tabindex=&quot;-1&quot; class=&quot;heading-element&quot; dir=&quot;auto&quot; style=&quot;box-sizing: border-box; margin-top: 4px; margin-bottom: 16px; line-height: 1.25; border-bottom: 0.666667px solid rgba(209, 217, 224, 0.7); padding-bottom: 0.3em; color: rgb(31, 35, 40); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Noto Sans&amp;quot;, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; background-color: rgb(255, 255, 255);&quot;&gt;2й вариант выбора Edge Node (ping или hop)&lt;/h2&gt;&lt;ul dir=&quot;auto&quot; style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 16px; padding-left: 2em; color: rgb(31, 35, 40); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Noto Sans&amp;quot;, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;li style=&quot;box-sizing: border-box;&quot;&gt;выбор ближайшей Edge Node за счет проб пути с клиента (ping или hop)&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; margin-top: 0.25em;&quot;&gt;клиент делает пробные запросы на каждую edge ноду, по времени отклика или по количеству hop (так делают ВК:)) выбирается ближайший&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; margin-top: 0.25em;&quot;&gt;минусы: множественные запросы на Edge_Node для проверки длины пути; дополнительный код на клиенте&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; margin-top: 0.25em;&quot;&gt;работает при небольшом количестве Edge_Node&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="170" width="1000" x="10" y="880" as="geometry" />
        </mxCell>
