          <mxGeometry height="60" width="120" x="290" y="2355" as="geometry" />
        </mxCell>
        <mxCell id="sqVjTN24lTVAuIK02rsc-59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="&lt;h3&gt;Statistic Counter&lt;br&gt;• подсчет статистики&lt;br&gt;• выставляет время кеширования&lt;br&gt;• упреждающее кеширование&lt;br&gt;• продление TTL&lt;br&gt;• ddos&lt;/h3&gt;" vertex="1">
          <mxGeometry height="170" width="280" x="484" y="2320" as="geometry" />
        </mxCell>
        <mxCell id="sqVjTN24lTVAuIK02rsc-60" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;" value="&lt;h3&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Base Storage 🗄️&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;i style=&quot;font-weight: normal;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• Хранение аудио/медиа файлов&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• S3 API совместимое&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• MinIO / Ceph / AWS S3&lt;/span&gt;&lt;/i&gt;&lt;/font&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="160" width="290" x="530" y="2550" as="geometry" />
        </mxCell>
